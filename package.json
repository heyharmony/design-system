{
  "name": "@heyharmony/design-system",
  "version": "0.1.0",
  "description": "Design tokens (themes, variables, colors) extracted from the Figma Harmony-2026 file, exported as CSS custom properties, typed TypeScript, and JSON.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heyharmony/design-system.git"
  },
  "homepage": "https://github.com/heyharmony/design-system#readme",
  "bugs": {
    "url": "https://github.com/heyharmony/design-system/issues"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./css": "./dist/css/tokens.css",
    "./tokens.json": "./dist/tokens.json"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
